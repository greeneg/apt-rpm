{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/include/lua*/"
            ],
            "defines": [
                "HAVE_CONFIG_H",
                "LIBDIR=\"/usr/local/lib64\"",
                "PKGDATADIR=\"/usr/local/share/apt\"",
                "LOCALEDIR=\"/usr/local/share/locale\"",
                "APT_DOMAIN=\"apt\""
            ],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "gnu17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-clang-x64"
        }
    ],
    "version": 4
}