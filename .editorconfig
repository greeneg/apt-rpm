root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[Makefile{,.*}]
indent_style = tab
indent_size = 4

[*.json]
indent_style = space
indent_size = 2

[*.lua]
indent_style = space
indent_size = 4

[*.cc]
indent_style = space
indent_size = 4

[*.h]
indent_style = space
indent_size = 4
